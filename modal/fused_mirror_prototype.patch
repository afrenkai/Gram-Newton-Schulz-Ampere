+    """Run the experimental same-CTA mirror after the CUTLASS epilogue."""
+    if not cutlass_symmetric_supports(accumulator, left, right):
+        raise ValueError(
+            "Tensor shape, layout, dtype, or device is unsupported by symmetric "
+            "SM80 CUTLASS"
