+template <typename BaseKernel, typename Element>
+struct FusedMirrorEpilogueKernel : BaseKernel {
+  using Params = typename BaseKernel::Params;
+  using SharedStorage = typename BaseKernel::SharedStorage;
+  using ThreadblockSwizzle = typename BaseKernel::ThreadblockSwizzle;
+
+  CUTLASS_DEVICE
+  void operator()(Params const &params, SharedStorage &shared_storage) {
+    BaseKernel::operator()(params, shared_storage);
+    __syncthreads();
+
+    ThreadblockSwizzle threadblock_swizzle;
+    cutlass::gemm::GemmCoord const tile_offset =
+        threadblock_swizzle.get_tile_offset(params.swizzle_log_tile);
+    int const tile_rows = BaseKernel::Mma::Shape::kM;
+    int const tile_columns = BaseKernel::Mma::Shape::kN;
+    int const source_row_start = tile_offset.m() * tile_rows;
+    int const source_column_start = tile_offset.n() * tile_columns;
+    int const destination_row_start = source_column_start;
+    int const destination_column_start = source_row_start;
+
+    for (int batch_index = threadblock_swizzle.get_batch_idx();
+         batch_index < params.batch_count; batch_index += gridDim.z) {
+      int64_t const batch_offset =
+          static_cast<int64_t>(batch_index) * params.stride_D;
+      for (int destination_linear = static_cast<int>(threadIdx.x);
+           destination_linear < tile_rows * tile_columns;
+           destination_linear += static_cast<int>(blockDim.x)) {
+        int const destination_local_row = destination_linear / tile_columns;
+        int const destination_local_column = destination_linear % tile_columns;
+        bool const is_strict_lower =
+            tile_offset.m() < tile_offset.n() ||
+            destination_local_row > destination_local_column;
+        int const source_row = source_row_start + destination_local_column;
+        int const source_column = source_column_start + destination_local_row;
+        int const destination_row =
+            destination_row_start + destination_local_row;
+        int const destination_column =
+            destination_column_start + destination_local_column;
+        if (is_strict_lower && source_row < params.problem_size.m() &&
+            source_column < params.problem_size.n() &&
+            destination_row < params.problem_size.m() &&
+            destination_column < params.problem_size.n()) {
+          Element *output =
+              reinterpret_cast<Element *>(params.ref_D.data()) + batch_offset;
+          output[static_cast<int64_t>(destination_row) *
+                     params.problem_size.n() +
+                 destination_column] = output[static_cast<int64_t>(source_row) *
+                                                  params.problem_size.n() +
+                                              source_column];
+        }
+      }
+    }
+  }
+};
+
+template <typename BaseOperation, typename Element>
+class FusedMirrorGemmBatched {
+public:
+  using Arguments = typename BaseOperation::Arguments;
+  using BaseKernel = typename BaseOperation::GemmKernel;
+  using GemmKernel = FusedMirrorEpilogueKernel<BaseKernel, Element>;
+  using ThreadblockShape = typename BaseOperation::ThreadblockShape;
+  using ThreadblockSwizzle = typename BaseOperation::ThreadblockSwizzle;
+
+private:
+  typename GemmKernel::Params params_;
+
+public:
+  static cutlass::Status can_implement(Arguments const &arguments) {
+    return BaseOperation::can_implement(arguments);
+  }
+
+  cutlass::Status initialize(Arguments const &arguments) {
+    ThreadblockSwizzle threadblock_swizzle;
+    cutlass::gemm::GemmCoord const grid_shape =
+        threadblock_swizzle.get_tiled_shape(
+            arguments.problem_size,
+            {ThreadblockShape::kM, ThreadblockShape::kN, ThreadblockShape::kK},
+            arguments.batch_count);
+    params_ = typename GemmKernel::Params{arguments.problem_size,
+                                          grid_shape,
+                                          arguments.ref_A.non_const_ref(),
+                                          arguments.stride_A,
+                                          arguments.ref_B.non_const_ref(),
+                                          arguments.stride_B,
+                                          arguments.ref_C.non_const_ref(),
+                                          arguments.stride_C,
+                                          arguments.ref_D,
+                                          arguments.stride_D,
+                                          arguments.epilogue,
+                                          arguments.batch_count};
+    return cutlass::Status::kSuccess;
+  }
+
+  cutlass::Status run(cudaStream_t stream) {
+    ThreadblockSwizzle threadblock_swizzle;
+    dim3 const grid =
+        threadblock_swizzle.get_grid_shape(params_.grid_tiled_shape);
+    dim3 const block(GemmKernel::kThreadCount, 1, 1);
+    int const shared_memory_size =
+        static_cast<int>(sizeof(typename GemmKernel::SharedStorage));
+    if (shared_memory_size >= (48 << 10)) {
+      cudaError_t const attribute_status = cudaFuncSetAttribute(
+          cutlass::Kernel<GemmKernel>,
+          cudaFuncAttributeMaxDynamicSharedMemorySize, shared_memory_size);
+      if (attribute_status != cudaSuccess) {
+        return cutlass::Status::kErrorInternal;
+      }
+    }
+    cutlass::arch::synclog_setup();
+    cutlass::Kernel<GemmKernel>
+        <<<grid, block, shared_memory_size, stream>>>(params_);
+    return cudaGetLastError() == cudaSuccess ? cutlass::Status::kSuccess
+                                             : cutlass::Status::kErrorInternal;
+  }
+
+  cutlass::Status operator()(Arguments const &arguments, void *,
+                             cudaStream_t stream) {
+    cutlass::Status const initialize_status = initialize(arguments);
+    if (initialize_status != cutlass::Status::kSuccess) {
+      return initialize_status;
+    }
+    return run(stream);
+  }
+};
